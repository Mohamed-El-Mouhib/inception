events { }
http {
	server {
		# listen on 443 for ipv4/ipv6 connection on secure transport layer security
		listen 443 ssl;
		listen [::]:443 ssl;

		server_name mel-mouh.42.fr;

		# set default root for out nginx with default static file to serve
		root	/var/www/html;
		index	index.html;

		# tls settings 
		ssl_protocols TLSv1.2 TLSv1.3;
		ssl_ciphers HIGH:!aNULL:!MD5;

		ssl_certificate /etc/nginx/server.crt;
		ssl_certificate_key /etc/nginx/server.key;
	}
}
